# Copy to .env (git-ignored) and set real values.
# Generate strong values, e.g.:  openssl rand -base64 48
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})

# Signs login tokens (JWT) and media/screenshot URLs. Minimum 32 characters.
APP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# PostgreSQL password (used by both the DB and the backend).
# NOTE: changing it after first start also requires:
#   docker exec signage-postgres psql -U signage -c "ALTER USER signage WITH PASSWORD '<new>';"
POSTGRES_PASSWORD=change-me-too
